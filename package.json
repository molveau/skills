{
  "name": "@molveau/skills",
  "version": "1.4.0",
  "description": "MCP server for Molveau Studio's design skills: AI-look tells, WCAG contrast, French typography, motion guardrails, an AI-prose check and the skills' playbooks. Zero dependencies.",
  "license": "MIT",
  "author": {
    "name": "Molveau Studio",
    "url": "https://www.molveau.ca"
  },
  "homepage": "https://www.molveau.ca/skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molveau/skills.git"
  },
  "bugs": {
    "url": "https://github.com/molveau/skills/issues"
  },
  "keywords": [
    "mcp",
    "writing",
    "ai-writing",
    "prose",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "agent-skills",
    "design",
    "ui",
    "ux",
    "accessibility",
    "wcag",
    "contrast",
    "anti-slop",
    "motion",
    "french-typography"
  ],
  "type": "module",
  "bin": {
    "molveau-skills-mcp": "skills/.mcp/server.mjs"
  },
  "exports": {
    ".": "./skills/.mcp/server.mjs",
    "./core": "./skills/.mcp/core.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "skills/.mcp/",
    "skills/.claude-plugin/plugin.json",
    "skills/anti-slop/scripts/detect-tells.mjs",
    "skills/anti-slop/scripts/story-contrast.mjs",
    "skills/french-typography/scripts/fr-typo.mjs",
    "skills/motion/scripts/check-motion.mjs",
    "skills/writing/scripts/check-writing.mjs",
    "skills/*/SKILL.md",
    "skills/*/references/playbook.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "PRIVACY.md",
    "TERMS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs test/design-grill/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
