          "skill": true
        }
      ],
      "exclude": [
        "**/agents/**",
        "skills/unslop/references/refs/**",
        "examples/**"
      ],
      "notes": "The reference images in `references/refs/` are not vendored, so the plugin ships no unread binary; view them upstream at https://github.com/heydamir/unslop/tree/main/skills/unslop/references/refs (story-dashboard-frames.webp shows the story video frame by frame). The upstream `examples/` folder is not vendored. Attribution required (CC BY 4.0): see `skills/anti-slop/SKILL.md`.",
      "attribution": {
        "title": "unslop",
        "author": "Damir Sokolovsky",
        "source": "https://github.com/heydamir/unslop",
        "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
        "note": "Vendored copy of the upstream skill folder, files unmodified (some files are excluded, see its SOURCE.md); adapted in skills/anti-slop/SKILL.md and skills/anti-slop/scripts/story.mjs (renderer, changes listed in its header, CC BY 4.0)"
      }
    },
